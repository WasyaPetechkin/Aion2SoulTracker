<Application x:Class="SoulTracker.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#24364B"/><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="BorderBrush" Value="#5D8191"/><Setter Property="Padding" Value="12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#1B293A"/><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="BorderBrush" Value="#40536B"/></Style>
  <Style x:Key="OverlayGrip" TargetType="Thumb">
   <Setter Property="Width" Value="23"/><Setter Property="Height" Value="23"/>
   <Setter Property="Cursor" Value="SizeNWSE"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Thumb">
     <Grid Background="Transparent"><Path Data="M 8,19 L 19,8 M 13,19 L 19,13 M 18,19 L 19,18" Stroke="#8BBFBA" StrokeThickness="1.5"/></Grid>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9EEF5"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E9EEF5"/><Setter Property="Margin" Value="0,0,22,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Background" Value="#25364B"/><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Application.Resources>
</Application>
