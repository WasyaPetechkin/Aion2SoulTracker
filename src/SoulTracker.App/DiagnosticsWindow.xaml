<Window x:Class="SoulTracker.App.DiagnosticsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SoulTracker.App"
 Width="880" Height="850" MinWidth="720" MinHeight="580" WindowStartupLocation="CenterOwner"
 Background="#101823" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="24" Background="#101823">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock x:Name="Heading" FontSize="27" FontWeight="SemiBold"/>
   <TextBlock x:Name="Subtitle" Foreground="#9EACBF" TextWrapping="Wrap" Margin="0,7,0,0"/>
  </StackPanel>
  <ScrollViewer x:Name="LivePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,12,0">
    <Border Background="#192639" CornerRadius="8" Padding="16" Margin="0,0,0,14">
     <StackPanel><TextBlock x:Name="Summary" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="ActionHint" Foreground="#B8C6D5" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
    <ItemsControl x:Name="Steps">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="#293B4F" BorderThickness="0,0,0,1" Padding="4,9">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,14,0"/>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Detail}" Foreground="#A8BACE" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="Counters" Foreground="#A8BACE" FontSize="12" TextWrapping="Wrap" Margin="4,14,0,0"/>
    <TextBlock x:Name="Issue" Foreground="#EDC878" TextWrapping="Wrap" FontSize="12" Margin="4,8,0,0"/>
    <TextBlock x:Name="Updated" Foreground="#8BA5BE" FontSize="11" Margin="4,10,0,6"/>
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="PreviewPanel" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock x:Name="PreviewHelp" TextWrapping="Wrap" Foreground="#B8C6D5" Margin="0,0,0,12"/>
   <TextBox x:Name="PreviewText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
    FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12"/>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,16,0,0">
   <TextBlock x:Name="PrivacyHint" TextWrapping="Wrap" Foreground="#9EACBF" FontSize="12" Margin="0,0,0,12"/>
   <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="#EDC878" FontSize="12" Margin="0,0,0,8"/>
   <DockPanel LastChildFill="False">
    <Button x:Name="CloseButton" DockPanel.Dock="Right" Click="CloseClicked"/>
    <StackPanel x:Name="LiveButtons" Orientation="Horizontal">
     <Button x:Name="PrepareButton" Click="PrepareClicked" Background="#2B595C"/><local:HelpBadge Topic="diagnosticsExport"/>
    </StackPanel>
    <WrapPanel x:Name="PreviewButtons" Visibility="Collapsed">
     <Button x:Name="BackButton" Click="BackClicked" Margin="0,0,8,0"/>
     <Button x:Name="SaveButton" Click="SaveClicked" Background="#2B595C" Margin="0,0,8,0"/>
     <Button x:Name="CopyButton" Click="CopyClicked"/><local:HelpBadge Topic="diagnosticsExport"/>
    </WrapPanel>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>
