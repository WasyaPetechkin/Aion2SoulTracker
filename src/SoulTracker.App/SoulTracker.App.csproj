<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>Aion2SoulTracker</AssemblyName>
  <Product>Aion 2 Soul Tracker</Product><Description>Aion 2 Soul Tracker</Description><Version>0.3.3</Version>
  <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>../../assets/app.ico</ApplicationIcon>
  <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  <!-- WPF owns DPI through the manifest; WinForms is used only for the tray icon. -->
  <NoWarn>$(NoWarn);WFO0003</NoWarn>
 </PropertyGroup>
 <ItemGroup>
  <Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/>
  <ProjectReference Include="../SoulTracker.Core/SoulTracker.Core.csproj"/>
  <Resource Include="../../assets/app.ico" Link="app.ico"/>
  <Content Include="../../assets/pet-catalog.json" Link="pet-catalog.json" CopyToOutputDirectory="PreserveNewest"/>
  <Content Include="../../assets/maps/**" Link="maps/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
  <Content Include="../../assets/pets/**" Link="pets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
  <Content Include="../../assets/data/**" Link="data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
  <Content Include="../../licenses/**" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
  <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest"/>
  <Content Include="../../START-HERE.txt" Link="START-HERE.txt" CopyToOutputDirectory="PreserveNewest"/>
 </ItemGroup>
</Project>
