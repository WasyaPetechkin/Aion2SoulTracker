<Window x:Class="SoulTracker.App.MapWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SoulTracker.App"
 Title="Aion 2 · Soul map" Width="360" Height="380" MinWidth="280" MinHeight="300"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 Topmost="True" ShowInTaskbar="False" ShowActivated="False" FontFamily="Segoe UI" FontSize="12">
 <Window.Resources>
  <Style x:Key="MapButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="9,4"/><Setter Property="MinWidth" Value="29"/>
   <Setter Property="Margin" Value="3,0,0,0"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Border CornerRadius="9" BorderBrush="#648498A8" BorderThickness="1">
   <Border.Background><SolidColorBrush x:Name="PanelBackground" Color="#0F1B29" Opacity="0.92"/></Border.Background>
   <Grid Margin="7,6,7,12">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid x:Name="DragSurface" MouseLeftButtonDown="DragHeader" Background="Transparent" Margin="0,0,0,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="MapTitle" Text="МЕСТА СПАВНА" FontWeight="SemiBold" Foreground="#99DDD4" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="SettingsButton" Style="{StaticResource MapButton}" Content="⋯" Click="ToggleSettings"/><local:HelpBadge Topic="mapOptions" Margin="1,0,2,0"/>
      <Button x:Name="LockButton" Style="{StaticResource MapButton}" Content="◇" Click="ToggleLock"/><local:HelpBadge Topic="lock" Margin="1,0,2,0"/>
      <Button x:Name="HideButton" Style="{StaticResource MapButton}" Content="×" Click="HideMap"/><local:HelpBadge Topic="hideMap" Margin="1,0,2,0"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="WorldSettings" Grid.Row="1" Margin="0,0,0,6" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <DockPanel><local:HelpBadge Topic="world" DockPanel.Dock="Right"/><ComboBox x:Name="WorldPicker" SelectedValuePath="Id" SelectionChanged="WorldChanged" Padding="5,3">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#101823" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox></DockPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
      <Button x:Name="FitButton" Style="{StaticResource MapButton}" Content="□" Click="FitMap"/><local:HelpBadge Topic="fit" Margin="1,0,2,0"/>
     </StackPanel>
    </Grid>
    <DockPanel Grid.Row="2" x:Name="TargetSettings" Visibility="Collapsed"><local:HelpBadge Topic="target" DockPanel.Dock="Right"/><ComboBox x:Name="TargetPicker" SelectedValuePath="Id" SelectionChanged="TargetChanged" Padding="5,3" Margin="0,0,0,6">
     <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#101823" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox></DockPanel>
    <Grid Grid.Row="3">
     <local:MapCanvas x:Name="Map"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
      <Button x:Name="PlayerButton" Style="{StaticResource MapButton}" Content="Я" Click="FollowPlayer"/><local:HelpBadge Topic="follow" Margin="1,0,2,0"/>
      <Button Style="{StaticResource MapButton}" Content="−" Click="ZoomOut" ToolTip="−"/><local:HelpBadge Topic="zoomOut" Margin="1,0,2,0"/>
      <Button Style="{StaticResource MapButton}" Content="+" Click="ZoomIn" ToolTip="+"/><local:HelpBadge Topic="zoomIn" Margin="1,0,2,0"/>
     </StackPanel>
     <Border x:Name="EmptyPanel" Background="#C4152130" CornerRadius="5" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12">
      <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
     </Border>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,5,0,0">
     <TextBlock x:Name="MapScope" Foreground="#A6C1D2" FontSize="10" Margin="0,0,18,2" TextTrimming="CharacterEllipsis"/>
     <StackPanel x:Name="MapDetails" Visibility="Collapsed">
     <DockPanel Margin="0,0,0,5"><local:HelpBadge Topic="all" DockPanel.Dock="Right"/><CheckBox x:Name="AllIncomplete" Content="Все незавершённые вместо выбранных" Margin="0" Checked="ModeChanged" Unchecked="ModeChanged"/></DockPanel>
     <TextBlock x:Name="SpawnSummary" Foreground="#A6C1D2" FontSize="11" TextWrapping="Wrap"/>
     <WrapPanel x:Name="Legend" Margin="0,4,0,0"/>
     </StackPanel>
     <TextBlock x:Name="PositionStatus" Foreground="#F2CC87" FontSize="10" Margin="0,2,18,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <TextBlock Grid.Row="5" x:Name="EditHint" Foreground="#91A5B8" FontSize="10" Margin="0,5,18,0" TextWrapping="Wrap" Visibility="Collapsed"/>
   </Grid>
  </Border>
  <Thumb x:Name="ResizeCorner" Style="{StaticResource OverlayGrip}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3"/>
 </Grid>
</Window>
