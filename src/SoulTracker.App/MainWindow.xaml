<Window x:Class="SoulTracker.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SoulTracker.App"
 Title="Aion 2 · Коллекция душ" Width="1280" Height="820" MinWidth="1050" MinHeight="620"
 Background="#101823" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Grid Background="#101823"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142031" BorderBrush="#24364A" BorderThickness="0,0,1,0">
   <Grid Margin="12,20,12,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="AION 2" FontWeight="Bold" FontSize="20" Foreground="#8DE0CE" Margin="8,0,0,3"/><TextBlock Text="SOUL TRACKER" FontSize="10" Foreground="#91A9BB" Margin="8,0,0,25"/></StackPanel>
    <StackPanel Grid.Row="1">
     <DockPanel Margin="0,0,0,8"><local:HelpBadge Topic="collection" DockPanel.Dock="Right"/><Button x:Name="CollectionNav" Content="Коллекция" Click="ShowCollectionPage" Padding="10,10" HorizontalContentAlignment="Left"/></DockPanel>
     <DockPanel><local:HelpBadge Topic="settings" DockPanel.Dock="Right"/><Button x:Name="SettingsNav" Content="Настройки" Click="ShowSettingsPage" Padding="10,10" HorizontalContentAlignment="Left"/></DockPanel>
    </StackPanel>
    <DockPanel Grid.Row="2"><local:HelpBadge Topic="exit" DockPanel.Dock="Right"/><Button x:Name="ExitButton" Content="⏻ Выход" Click="ExitClicked" Padding="10,10" HorizontalContentAlignment="Left"/></DockPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
 <Grid x:Name="CollectionPage" Margin="24" Background="#101823">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock x:Name="Heading" Text="Коллекция душ" FontSize="29" FontWeight="SemiBold"/>
    <TextBlock x:Name="Character" Text="Aion 2 · Global EU" Foreground="#9EACBF" Margin="0,6,0,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="ExportButton" Content="Сохранённые данные" Click="OpenExport"/>
    <local:HelpBadge Topic="saved"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#192639" CornerRadius="8" Padding="18" Margin="0,20,0,16">
   <StackPanel><TextBlock x:Name="Summary" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="Source" Foreground="#88CED8" Margin="0,8,0,0"/>
    <TextBlock x:Name="CaptureStatus" Foreground="#AAB7C9" Margin="0,5,0,0" TextWrapping="Wrap"/>
    <Border x:Name="PrerequisitePanel" Background="#2D3440" CornerRadius="5" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
     <StackPanel><TextBlock x:Name="PrerequisiteText" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,10,0,0"><Button x:Name="DownloadNpcap" Click="OpenNpcap" Margin="0,0,10,0"/><local:HelpBadge Topic="npcap"/><Button x:Name="RecheckNpcap" Click="RetryCapture"/><local:HelpBadge Topic="recheck"/></WrapPanel>
     </StackPanel>
    </Border>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,0,0,14">
   <WrapPanel Margin="0,0,0,12">
    <StackPanel Orientation="Horizontal"><CheckBox x:Name="HudVisible" Content="Счётчик душ" Checked="HudVisibilityChanged" Unchecked="HudVisibilityChanged" Margin="0"/><local:HelpBadge Topic="hud"/></StackPanel>
    <StackPanel Orientation="Horizontal"><CheckBox x:Name="MapVisible" Content="Интерактивная карта" Checked="MapVisibilityChanged" Unchecked="MapVisibilityChanged" Margin="0"/><local:HelpBadge Topic="map"/></StackPanel>
    <StackPanel Orientation="Horizontal"><CheckBox x:Name="HudLocked" Content="Клики в игру" Checked="HudLockChanged" Unchecked="HudLockChanged" Margin="0"/><local:HelpBadge Topic="lock"/></StackPanel>
    <TextBlock x:Name="HudOpacityLabel" Text="Плотность фона" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <StackPanel Orientation="Horizontal"><Slider x:Name="HudOpacity" Minimum="0.25" Maximum="1" Width="90" VerticalAlignment="Center" ValueChanged="HudAppearanceChanged"/><local:HelpBadge Topic="opacity"/></StackPanel>
   </WrapPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><CheckBox x:Name="FocusMode" Content="Режим фокуса" Margin="0" Checked="FocusChanged" Unchecked="FocusChanged"/><local:HelpBadge Topic="focus"/></StackPanel>
   <TextBlock x:Name="HudHint" Text="Отметь цели в колонке HUD · Ctrl+Alt+H показать · Ctrl+Alt+L клики в игру" Foreground="#8BA5BE" FontSize="12" Margin="0,0,0,13" TextWrapping="Wrap"/>
   <WrapPanel>
   <StackPanel Orientation="Horizontal"><CheckBox x:Name="Cogni" Content="Cogni" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0"/><local:HelpBadge Topic="category"/></StackPanel>
   <StackPanel Orientation="Horizontal"><CheckBox x:Name="Fera" Content="Fera" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0"/><local:HelpBadge Topic="category"/></StackPanel>
   <StackPanel Orientation="Horizontal"><CheckBox x:Name="Natura" Content="Natura" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0"/><local:HelpBadge Topic="category"/></StackPanel>
   <StackPanel Orientation="Horizontal"><CheckBox x:Name="Varian" Content="Varian" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0"/><local:HelpBadge Topic="category"/></StackPanel>
   <StackPanel Orientation="Horizontal"><CheckBox x:Name="Special" Content="Специальные" IsChecked="False" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0"/><local:HelpBadge Topic="special"/></StackPanel>
   </WrapPanel>
   <TextBlock x:Name="CategoryHint" Foreground="#8BA5BE" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="3" Margin="0,0,0,15">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,10,0"><local:HelpBadge Topic="search" DockPanel.Dock="Right"/><TextBox x:Name="Search" ToolTip="Поиск по имени или ID" Background="#1B293A" Foreground="White"
    BorderBrush="#304057" Padding="10,7" TextChanged="FilterChanged" Margin="0,0,0,0"/></DockPanel>
   <StackPanel Orientation="Horizontal" Grid.Column="1"><CheckBox x:Name="HideCompleted" Content="Скрыть MAX" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0"/><local:HelpBadge Topic="max"/></StackPanel>
   <StackPanel Orientation="Horizontal" Grid.Column="2"><CheckBox x:Name="OwnedOnly" Content="Только полученные" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0"/><local:HelpBadge Topic="owned"/></StackPanel>
  </Grid>
  <DataGrid Grid.Row="4" x:Name="Pets" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
   EnableRowVirtualization="True" HeadersVisibility="Column" RowHeight="37" Background="#142031" Foreground="#E9EEF5"
   RowBackground="#142031" AlternatingRowBackground="#19273A" BorderThickness="0" GridLinesVisibility="None" SelectionMode="Single">
   <DataGrid.Resources>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#24354D"/><Setter Property="Foreground" Value="#AFBED2"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,5"/></Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="HUD" Width="75">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <CheckBox IsChecked="{Binding IsTracked, Mode=OneWay}" IsEnabled="{Binding CanTrack}" Click="PinClicked"
        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" ToolTip="HUD"/>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Монстр / питомец" Binding="{Binding Name}" Width="*" MinWidth="180"/>
    <DataGridTextColumn Header="Категория" Binding="{Binding Genus}" Width="105"/>
    <DataGridTextColumn Header="Уровень" Binding="{Binding LevelText}" Width="100"/>
    <DataGridTextColumn Header="Души на ступени" Binding="{Binding Stage}" Width="140"/>
    <DataGridTextColumn Header="До максимума" Binding="{Binding RemainingText}" Width="130"/>
    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="5" Margin="0,15,0,0">
   <TextBlock x:Name="Recent" Foreground="#85D5C3" TextWrapping="Wrap"/>
   <TextBlock x:Name="Footnote" Text=""
    Foreground="#9CAAC0" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>

 <Grid x:Name="SettingsPage" Margin="28" Visibility="Collapsed">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock x:Name="SettingsTitle" Text="Настройки программы" FontSize="29" FontWeight="SemiBold"/>
   <TextBlock x:Name="SettingsSubtitle" Text="Настрой интерфейс и управление под себя" Foreground="#9EACBF" Margin="0,8,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel MaxWidth="760" HorizontalAlignment="Left">
    <Border Background="#192639" CornerRadius="8" Padding="20" Margin="0,0,0,18">
     <StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="LanguageLabel" Text="Язык" FontSize="17" FontWeight="SemiBold"/><local:HelpBadge Topic="language"/></StackPanel>
      <ComboBox x:Name="LanguagePicker" Width="180" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="8,6" SelectionChanged="LanguageChanged">
     <ComboBoxItem Tag="ru"><TextBlock Text="Русский" Foreground="#101823"/></ComboBoxItem>
     <ComboBoxItem Tag="en"><TextBlock Text="English" Foreground="#101823"/></ComboBoxItem>
    </ComboBox>
     </StackPanel>
    </Border>
    <Border Background="#192639" CornerRadius="8" Padding="20" Margin="0,0,0,18">
     <StackPanel><TextBlock x:Name="HotkeysTitle" Text="Горячие клавиши" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="HotkeysHelp" Foreground="#AAB7C9" TextWrapping="Wrap" Margin="0,8,0,16"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock x:Name="HudKeyLabel" Text="Счётчик душ" VerticalAlignment="Center"/>
       <TextBox Grid.Column="1" x:Name="HudKeyInput" IsReadOnly="True" Padding="10,7" Margin="0,4" PreviewKeyDown="CaptureHotkey" Tag="hud"/><local:HelpBadge Grid.Column="2" Topic="hotkey"/>
       <TextBlock Grid.Row="1" x:Name="MapKeyLabel" Text="Интерактивная карта" VerticalAlignment="Center"/>
       <TextBox Grid.Row="1" Grid.Column="1" x:Name="MapKeyInput" IsReadOnly="True" Padding="10,7" Margin="0,4" PreviewKeyDown="CaptureHotkey" Tag="map"/><local:HelpBadge Grid.Row="1" Grid.Column="2" Topic="hotkey"/>
       <TextBlock Grid.Row="2" x:Name="LockKeyLabel" Text="Клики в игру" VerticalAlignment="Center"/>
       <TextBox Grid.Row="2" Grid.Column="1" x:Name="LockKeyInput" IsReadOnly="True" Padding="10,7" Margin="0,4" PreviewKeyDown="CaptureHotkey" Tag="lock"/><local:HelpBadge Grid.Row="2" Grid.Column="2" Topic="hotkey"/>
      </Grid>
      <WrapPanel Margin="0,14,0,0"><Button x:Name="ApplyKeysButton" Content="Применить" Click="ApplyHotkeys"/><local:HelpBadge Topic="apply"/>
       <Button x:Name="ResetKeysButton" Content="По умолчанию" Click="ResetHotkeys"/><local:HelpBadge Topic="resetKeys"/>
      </WrapPanel>
      <TextBlock x:Name="HotkeyStatus" Foreground="#8EDCC9" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <Border Background="#192639" CornerRadius="8" Padding="20">
     <StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="ScaleTitle" Text="Размер строк счётчика" FontSize="17" FontWeight="SemiBold"/><local:HelpBadge Topic="scale"/></StackPanel>
      <TextBlock x:Name="ScaleHelp" Foreground="#AAB7C9" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <DockPanel><TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
       <Slider x:Name="HudRowScale" Minimum="0.65" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="RowScaleChanged" MinWidth="300"/>
      </DockPanel>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
  </Grid>
 </Grid>
</Window>
